{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true, "noEmit": true,
    "types": [], "typeRoots": ["./node_modules/@types"],
    "paths": { "@app/form-engine": ["./packages/form-engine/src/index.ts"] }
  },
  "include": ["packages/*/src", "app/src", "backend/*.ts"],
  "exclude": ["backend/dev.ts", "backend/funcao-*.ts", "backend/*.test.ts"]
}
