# Copie para .env.local (que o git ignora) só se for rodar comandos na sua máquina.
# Em produção NADA disso fica em arquivo: os valores vão em
#   GitHub → Settings → Secrets and variables → Actions   (o workflow repassa ao Supabase)
# Claude nunca vê nem digita estes valores.

# --- Variáveis do GitHub (aba "Variables": não são segredo) ---
SUPABASE_PROJECT_REF=          # o código do projeto, ex.: abcdefghijklmnopqrst (Settings → General)
SUPABASE_ANON_KEY=             # chave "anon public" (Settings → API) — vai no app, é pública por natureza
EMAIL_REMETENTE=               # opcional, ex.: Inspeta <inspecoes@seudominio.com.br> (domínio verificado no Resend)

# --- Segredos do GitHub (aba "Secrets") ---
SUPABASE_ACCESS_TOKEN=         # token pessoal da Supabase CLI (Account → Access Tokens)
SUPABASE_DB_PASSWORD=          # a senha do banco que você escolheu ao criar o projeto
RESEND_API_KEY=                # opcional: sem ela os e-mails ficam "Na fila" na caixa de saída

# --- Calculadas pelo workflow (não preencha) ---
# SUPABASE_URL=https://<SUPABASE_PROJECT_REF>.supabase.co
# app_url, origens e o segredo do agendador ficam na tabela interno.config (o segredo é gerado pelo próprio banco)
# INSPETA_API=<SUPABASE_URL>/functions/v1/api
# INSPETA_AUTH=<SUPABASE_URL>/auth/v1
# INSPETA_ANON_KEY=<SUPABASE_ANON_KEY>
# SUPABASE_DB_URL e SUPABASE_SERVICE_ROLE_KEY o próprio Supabase injeta nas funções.

# --- Só para desenvolvimento local (backend/dev.ts) ---
DATABASE_URL=                  # ex.: o que backend/scripts/pg-local.sh imprime
